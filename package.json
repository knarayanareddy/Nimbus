{
  "name": "nimbus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-opennext-preview.cjs",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "build:static": "EXPORT_STATIC=true next build --webpack && node scripts/generate-security-headers.js",
    "start": "next start",
    "lint": "eslint app components lib --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test:adapter": "node --test scripts/patch-opennext-preview.test.cjs",
    "test:unit": "tsc -p tsconfig.unit.json && mocha .test-build/tests/*.test.js",
    "verify:receipt": "ts-node --project tsconfig.offchain.json scripts/verify-receipt.ts",
    "test:e2e": "playwright test",
    "test:rust": "cargo test --manifest-path programs/nimbus/Cargo.toml --locked",
    "build:cloudflare": "node scripts/patch-opennext-preview.cjs && opennextjs-cloudflare build",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "preview:cloudflare": "npm run build:cloudflare && wrangler dev",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "demo:receipt": "ts-node --project tsconfig.offchain.json scripts/anchor-demo-receipt.ts",
    "demo:policy:localnet": "ts-node --project tsconfig.offchain.json scripts/localnet-policy-proof.ts",
    "demo:receipt:localnet": "ts-node --project tsconfig.offchain.json scripts/localnet-receipt.ts",
    "test": "anchor test",
    "oracle": "ts-node --project tsconfig.offchain.json offchain/oracle-aggregator.ts",
    "monitor": "ts-node --project tsconfig.offchain.json offchain/policy-monitor.ts",
    "deploy": "ts-node --project tsconfig.offchain.json scripts/deploy.ts",
    "deploy:dryrun": "ts-node --project tsconfig.offchain.json scripts/deploy.ts --dry-run",
    "demo": "ts-node --project tsconfig.offchain.json scripts/demo-settle.ts",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.29.0",
    "@solana/spl-token": "^0.3.9",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-phantom": "^0.9.30",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.34",
    "@solana/web3.js": "^1.87.6",
    "axios": "^1.6.8",
    "bs58": "^4.0.1",
    "framer-motion": "^12.41.0",
    "lucide-react": "^1.21.0",
    "next": "16.4.0",
    "node-fetch": "^2.7.0",
    "postgres": "^3.4.4",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.9.0",
    "redis": "^4.6.13",
    "tweetnacl": "^1.0.3"
  },
  "overrides": {
    "glob@^10": "10.5.0",
    "serialize-javascript": "7.0.5",
    "@types/react": "^18",
    "ws": "^8.17.1",
    "uuid": "^9.0.1",
    "undici": "^6.19.2",
    "@coral-xyz/borsh": "^0.29.0",
    "elliptic": "^6.5.7",
    "browserify-sign": "^4.2.3",
    "crypto-browserify": "^3.12.1",
    "uuidv4": "^6.2.13",
    "@walletconnect/utils": "^2.17.0",
    "@walletconnect/core": "^2.17.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.10",
    "@playwright/test": "1.63.0",
    "@types/bn.js": "^5.2.0",
    "@types/bs58": "^4.0.4",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20",
    "@types/node-fetch": "^2.6.11",
    "@types/react": "^18",
    "autoprefixer": "^10.5.0",
    "chai": "^4.3.10",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "mocha": "^10.2.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "wrangler": "4.149.0"
  }
}
